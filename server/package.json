{
  "name": "jingling-server",
  "version": "0.1.0",
  "private": true,
  "description": "鲸灵 JingLing 后端:Agent 运行时、会话/分支存储、DeepSeek 适配层",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/smoke.test.ts test/reminders.test.ts test/search.test.ts test/modelkey.test.ts test/web.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.8",
    "@fastify/websocket": "^11.3.7",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

