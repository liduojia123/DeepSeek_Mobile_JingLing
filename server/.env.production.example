# 生产环境变量示例:复制为 .env 后填 key,放在部署目录(不与代码同库)
PORT=3000
HOST=0.0.0.0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 留空 = 一次性码(配对后轮换);填值 = 固定码(长期有效,带失败限速)
PAIRING_CODE=
DB_PATH=/app/data/jingling.db
MOCK=0
MOCK_DELAY_MS=0
DEV_CORS=0
LOG_REQUESTS=1
PRICE_IN_CNY_PER_MTOK=0.5
PRICE_OUT_CNY_PER_MTOK=2
DAILY_BUDGET_CNY=20
MAX_CONTENT_CHARS=100000
UPSTREAM_TIMEOUT_MS=180000
ENABLE_WEB_SEARCH=1
ENABLE_READ_URL=1
SAFETY_LEVEL=high
TITLE_ENABLED=1
FILE_MAX_BYTES=104857600
SEARCH_PRICE_CNY_PER_CALL=0.005
FETCH_PRICE_CNY_PER_CALL=0.005
OCR_PRICE_CNY_PER_PAGE=0.0015