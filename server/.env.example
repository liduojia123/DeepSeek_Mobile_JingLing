# 复制为 server/.env 后填写。.env 不入库。
PORT=3000
HOST=0.0.0.0
# DeepSeek API key,只允许出现在本文件与服务器环境变量
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 一次性配对码;留空则每次启动自动生成并打印到控制台
PAIRING_CODE=
DB_PATH=./data/jingling.db
# 1 = 不调用真实 API,输出等价假事件流(无 key 可开发)
MOCK=1
# MOCK 流每段间隔(ms),便于肉眼观察流式
MOCK_DELAY_MS=25
# token 单价(元/百万 token),按官方公告价填写;用于 usage 与 message_end 的 cost_estimate
PRICE_IN_CNY_PER_MTOK=0.5
PRICE_OUT_CNY_PER_MTOK=2
# 每日预算(元),M5 启用熔断,M0 仅读取
DAILY_BUDGET_CNY=20
# 单条消息字符上限
MAX_CONTENT_CHARS=100000
# 上游流式响应超时(ms):超过即放弃本轮,避免会话卡在 generating
UPSTREAM_TIMEOUT_MS=120000
# 1 = 输出请求日志(默认开)
LOG_REQUESTS=1
