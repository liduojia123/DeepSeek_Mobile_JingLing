{
  "name": "jingling-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "鲸灵 JingLing 远程开发桥:把本机 dsh 会话/任务/工具调用确认转发到手机",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
